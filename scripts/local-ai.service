[Unit]
Description=Jetson Local AI web interface
After=network.target
[Service]
WorkingDirectory=@AI_ROOT@
ExecStart=@AI_ROOT@/venv/bin/python @AI_ROOT@/app.py
Restart=on-failure
RestartSec=5
Environment=GRADIO_ANALYTICS_ENABLED=False
# Default is this device only. Uncomment to allow other devices on your LAN (there is NO login):
#Environment=LOCAL_AI_HOST=0.0.0.0
[Install]
WantedBy=default.target
